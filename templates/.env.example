# ============================================
# 模型分层策略：被测模型 ＜ 评分模型 ≤ DSPy 优化器
# 被测模型选成本最优，评分和优化模型选能力更强的
# ============================================

# ============================================
# 🎯 被测模型（eval target）— 你要评估的 Agent 用的模型
# 选型：成本优先，选性价比最高的轻量模型
# ============================================
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================
# 🧑‍⚖️ 评分模型（全局默认）— 用于 llm-rubric 断言
# 选型：判断力优先，须强于被测模型才能准确评分
# 如需单个 Agent 覆盖，在其 promptfooconfig.yaml 的 defaultTest.options.provider 中配置
# ============================================
PROMPTFOO_GRADING_MODEL=openai:chat:<grading-model-name>
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-xxx

# ============================================
# 📊 Langfuse — 可观测性平台
# 脚本优先读 LANGFUSE_HOST，未设时回退到 LANGFUSE_BASE_URL
# 私有部署强制 https 且证书为自签/IP 时：URL 用 https:// 并设 LANGFUSE_SSL_VERIFY=false
# ⚠️ 安全风险（#23）：关闭 TLS 校验后流量可被中间人截获（含 Langfuse 密钥与线上数据），
#   仅限可信内网使用；公网/生产接入应改用受信证书并保持校验开启
# （http 会被 302 跳转，POST 会降级为 GET，必须直接写 https）
# ============================================
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://your-langfuse.com

# ============================================
# 🧪 线上评估模型（eval-online）— 可选
# 选型：与评分模型同级或更强
# 未设时脚本自动回退复用 DASHSCOPE_* 变量
# ============================================
# EVAL_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EVAL_MODEL_API_KEY=sk-xxx
# EVAL_MODEL_NAME=<eval-model-name>

# ============================================
# 🧠 DSPy 优化 — 仅在使用 eval-dspy-optimize 时需要
# 选型：质量优先，作为「教师」须 ≥ 评分模型
# 三个变量均独立配置，不回退到 DASHSCOPE_* 变量
# ============================================
DSPY_LM_MODEL=openai/<optimizer-model-name>
DSPY_LM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DSPY_LM_API_KEY=sk-xxx
# LANGFUSE_SSL_VERIFY=false
